          "sql": "CREATE TABLE IF NOT EXISTS \"favorites\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"barcode\" TEXT NOT NULL, \"added_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"), UNIQUE (\"user_id\", \"barcode\"));"
