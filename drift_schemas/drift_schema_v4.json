          "sql": "CREATE TABLE IF NOT EXISTS \"counterfeit_products\" (\"id\" TEXT NOT NULL, \"brand_name\" TEXT NOT NULL, \"product_name\" TEXT NOT NULL, \"category\" TEXT NULL, \"violation_type\" TEXT NOT NULL, \"violation_detail\" TEXT NULL, \"province\" TEXT NULL, \"detection_date\" INTEGER NULL, \"barcode\" TEXT NULL, \"source_url\" TEXT NULL, \"synced_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), PRIMARY KEY (\"id\"));"
