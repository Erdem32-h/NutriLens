<?xml version="1.0" encoding="utf-8"?>
<!-- Deep emerald Cozy gradient card with subtle glass border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="135"
        android:startColor="#0B2619"
        android:centerColor="#13422C"
        android:endColor="#1C6B46" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
